{
    "manifest_version": 3,
    "name": "EasyWPP",
    "version": "1.0.1",
    "description": "Envie mensagens no WhatsApp Web sem precisar salvar o contato! Selecione, clique com o botão direito e inicie a conversa.",
    "permissions": ["contextMenus", "tabs", "scripting"],
    "host_permissions": ["<all_urls>"],
    "background": { "service_worker": "background.js" },
    "content_scripts": [
      {
        "matches": ["<all_urls>"],
        "js": ["content.js"]
      }
    ],
    "icons": {
      "16": "images/icon-16.png",
      "48": "images/icon-48.png",
      "128": "images/icon-128.png"
    }
}